rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own doc: users/{uid}
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Shared store: every signed-in staff account reads/writes the SAME
    // products, quotes and settings, so a sale on one account deducts
    // stocks on all accounts. Small trusted staff only.
    match /shared/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
